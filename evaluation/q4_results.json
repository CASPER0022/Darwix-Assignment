        {
          "speaker": "agent",
          "text": "Got it.",
          "call_time_s": 62.5,
          "duration_s": 1.5,
          "asr_latency_ms": 258.6,
          "language": "English"
        },
        {
          "speaker": "agent",
          "text": "And roughly what does the business turn over in a year?",
