          "duration_s": 3.8,
          "asr_latency_ms": 281.6,
          "language": "English"
        },
        {
          "speaker": "agent",
          "text": "I see.",
          "call_time_s": 19.1,
          "duration_s": 1.5,
          "asr_latency_ms": 339.8,
          "language": "English"
        },
        {
          "speaker": "agent",
          "text": "The installment is showing as pending.",
          "call_time_s": 23.5,
          "duration_s": 3.0,
          "asr_latency_ms": 1175.5,
          "language": "English"
        },
        {
          "speaker": "agent",
          "text": "When can we expect the payment?",
          "call_time_s": 23.5,
          "duration_s": 2.6,
          "asr_latency_ms": 251.3,
          "language": "English"
        },
        {
          "speaker": "customer",
          "text": "I explained this already. Business has been very slow this season. I don't have the money right now.",
