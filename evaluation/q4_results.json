          "duration_s": 8.1,
          "asr_latency_ms": 451.0,
          "language": "English"
        },
        {
          "speaker": "agent",
          "text": "I understand.",
          "call_time_s": 36.9,
          "duration_s": 1.9,
          "asr_latency_ms": 579.9,
          "language": "English"
        },
        {
          "speaker": "agent",
          "text": "Can you make the payment by the 5th of this month?",
          "call_time_s": 36.9,
          "duration_s": 3.4,
          "asr_latency_ms": 306.9,
          "language": "English"
        },
        {
          "speaker": "customer",
          "text": "This is the third time I am telling someone the same thing.",
          "call_time_s": 41.1,
          "duration_s": 4.5,
          "asr_latency_ms": 308.8,
          "language": "English"
        },
        {
          "speaker": "customer",
          "text": "Nobody is listening.",
          "call_time_s": 45.5,
          "duration_s": 2.0,
          "asr_latency_ms": 263.8,
          "language": "English"
        },
        {
          "speaker": "agent",
          "text": "Right.",
          "call_time_s": 50.5,
          "duration_s": 1.5,
          "asr_latency_ms": 259.2,
          "language": "English"
        },
        {
          "speaker": "agent",
          "text": "So can I note down the fifth as the payment date?",
          "call_time_s": 52.1,
          "duration_s": 3.5,
          "asr_latency_ms": 358.4,
          "language": "English"
        },
        {
          "speaker": "customer",
          "text": "This is a complete waste of my time.",
