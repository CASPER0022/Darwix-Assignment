          "asr_latency_ms": 377.7,
          "language": "English"
        },
        {
          "speaker": "agent",
          "text": "This call is recorded for quality purposes.",
          "call_time_s": 4.7,
          "duration_s": 3.5,
          "asr_latency_ms": 361.1,
          "language": "English"
        },
        {
          "speaker": "agent",
          "text": "I'm calling about your business loan inquiry.",
          "call_time_s": 8.1,
          "duration_s": 3.6,
          "asr_latency_ms": 293.9,
          "language": "English"
        },
        {
          "speaker": "customer",
          "text": "Oh, hello. Sorry. One second. The traffic here is very loud.",
          "call_time_s": 12.1,
          "duration_s": 6.1,
          "asr_latency_ms": 509.5,
          "language": "English"
        },
        {
          "speaker": "agent",
          "text": "No problem. Take your time.",
          "call_time_s": 18.5,
          "duration_s": 2.9,
          "asr_latency_ms": 268.1,
          "language": "English"
        },
        {
          "speaker": "customer",
          "text": "Yes, sorry. What was it about again?",
          "call_time_s": 22.5,
          "duration_s": 4.3,
          "asr_latency_ms": 336.5,
          "language": "English"
        },
        {
          "speaker": "customer",
          "text": "I think I filled something online, maybe.",
