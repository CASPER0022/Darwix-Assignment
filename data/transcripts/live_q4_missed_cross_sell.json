  "transcript": [
    {
      "speaker": "agent",
      "text": "Good afternoon, this is Anaya from the Business Loans team.",
      "call_time_s": 0.3,
      "duration_s": 4.3,
      "asr_latency_ms": 367.6,
      "language": "English"
    },
    {
      "speaker": "agent",
      "text": "Just so you know, I'm an AI assistant, not a human agent, and this call is recorded for quality purposes.",
      "call_time_s": 4.7,
      "duration_s": 7.9,
      "asr_latency_ms": 567.4,
      "language": "English"
    },
    {
      "speaker": "agent",
      "text": "Is this a good time?",
      "call_time_s": 12.7,
      "duration_s": 2.1,
      "asr_latency_ms": 258.7,
      "language": "English"
    },
    {
      "speaker": "customer",
      "text": "Yes, go ahead.",
      "call_time_s": 15.1,
      "duration_s": 2.1,
      "asr_latency_ms": 294.7,
      "language": "English"
    },
    {
      "speaker": "agent",
      "text": "Could you tell me the name of your business and how long it has been running?'",
      "call_time_s": 19.1,
      "duration_s": 4.6,
      "asr_latency_ms": 373.8,
      "language": "English"
    },
    {
      "speaker": "customer",
      "text": "It's Chauhan Logistics, running about 6 years now. Actually, we just bought a second truck last month, and we are planning another vehicle next quarter.",
      "call_time_s": 24.1,
      "duration_s": 11.1,
      "asr_latency_ms": 487.7,
      "language": "English"
    },
    {
      "speaker": "agent",
      "text": "Understood.",
      "call_time_s": 35.5,
      "duration_s": 1.7,
      "asr_latency_ms": 250.4,
      "language": "English"
    },
    {
      "speaker": "agent",
      "text": "And what was your turnover in the last financial year?",
      "call_time_s": 37.1,
      "duration_s": 3.8,
      "asr_latency_ms": 316.9,
      "language": "English"
    },
    {
      "speaker": "customer",
      "text": "About 67 lakhs.",
      "call_time_s": 44.3,
      "duration_s": 2.5,
      "asr_latency_ms": 501.0,
      "language": "English"
    },
    {
      "speaker": "customer",
      "text": "The second vehicle is really stretching our working capital. That's the whole problem.",
      "call_time_s": 44.3,
      "duration_s": 5.8,
      "asr_latency_ms": 387.5,
      "language": "English"
    },
    {
      "speaker": "agent",
      "text": "Right.",
      "call_time_s": 50.5,
      "duration_s": 1.5,
      "asr_latency_ms": 261.2,
      "language": "English"
    },
    {
      "speaker": "agent",
      "text": "And how much were you looking to borrow?",
      "call_time_s": 51.9,
      "duration_s": 2.8,
      "asr_latency_ms": 280.0,
      "language": "English"
    },
    {
      "speaker": "customer",
      "text": "Around 18 lakhs. We also want to expand to a new depot if things go well.",
      "call_time_s": 54.9,
      "duration_s": 7.1,
      "asr_latency_ms": 536.3,
      "language": "English"
    },
    {
      "speaker": "agent",
      "text": "Noted.",
      "call_time_s": 62.3,
      "duration_s": 1.5,
      "asr_latency_ms": 252.6,
      "language": "English"
    },
    {
      "speaker": "agent",
      "text": "Is the business GST registered?",
      "call_time_s": 63.9,
      "duration_s": 2.9,
      "asr_latency_ms": 259.5,
      "language": "English"
    },
    {
      "speaker": "customer",
      "text": "Yes, it is.",
      "call_time_s": 67.1,
      "duration_s": 1.7,
      "asr_latency_ms": 233.8,
      "language": "English"
    },
    {
      "speaker": "agent",
      "text": "I'll pass this to a credit officer for review and someone will call you back.",
      "call_time_s": 70.7,
      "duration_s": 5.0,
      "asr_latency_ms": 359.7,
      "language": "English"
    },
