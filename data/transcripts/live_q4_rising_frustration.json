      "asr_latency_ms": 579.9,
      "language": "English"
    },
    {
      "speaker": "agent",
      "text": "Can you make the payment by the 5th of this month?",
      "call_time_s": 36.9,
      "duration_s": 3.4,
      "asr_latency_ms": 306.9,
      "language": "English"
    },
    {
