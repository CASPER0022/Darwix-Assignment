# ---------------------------------------------------------------------------
# Darwix AI Assessment - environment template
# Copy to .env and fill in.  Both providers have a free tier; no card required.
# ---------------------------------------------------------------------------

# Google AI Studio -> https://aistudio.google.com/apikey
# Used for: dialogue LLM (Q1/Q3), KB structuring (Q2), embeddings (Q2),
#           secondary ASR for the Q3 benchmark.
GEMINI_API_KEY=

# Groq Cloud -> https://console.groq.com/keys
# Used for: streaming ASR (whisper-large-v3-turbo) and the latency-critical
#           nudge LLM in Q4.
GROQ_API_KEY=

# ---- model selection (override only if a model id is retired) --------------
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GROQ_DIALOG_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_ASR_MODEL=whisper-large-v3-turbo

# ---- runtime ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# Retrieval: below this fused score the agent must say it does not know
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_TOP_K=4

# Q4 nudge control
NUDGE_MIN_CONFIDENCE=0.55
NUDGE_COOLDOWN_SECONDS=45
NUDGE_TTL_SECONDS=90
NUDGE_MAX_ACTIVE=3

# Optional: where escalations are POSTed (leave blank to log to file only)
ESCALATION_WEBHOOK_URL=
